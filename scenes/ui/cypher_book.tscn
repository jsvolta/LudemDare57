bbcode_enabled = true
text = "
[code][u]Morse Code[/u]
[table=3]

[cell]A .-						[/cell]			[cell]J .---					[/cell]			[cell]S ...[/cell]
[cell]B -...[/cell]			[cell]K -.-[/cell]			[cell]T -[/cell]
[cell]C -.-.[/cell]			[cell]L .-..[/cell]			[cell]U ..-[/cell]
[cell]D -..[/cell]			[cell]M --[/cell] 			[cell]V ...-[/cell]
[cell]E .[/cell]				 [cell]N -.[/cell]			[cell]W .--[/cell]
[cell]F ..-.[/cell]			[cell]O ---[/cell]			[cell]X -..-[/cell]
[cell]G --.[/cell]			[cell]P .--.[/cell]			[cell]Y -.--[/cell]
[cell]H ....[/cell]			[cell]Q --.-[/cell]			[cell]Z --..[/cell]
[cell]I ..[/cell]				[cell]R .-.[/cell]			

[/table]"
fit_content = true
scroll_active = false
tab_size = 2

